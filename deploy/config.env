# Configuración del despliegue. Cambia estos valores según tu red.
# Los scripts los leen; también se pueden sobreescribir con variables de entorno.

# Usuario e IP del servidor (la ThinkPad con Kali). Para saber la IP: `ip -4 addr`
SERVIDOR_USUARIO="${SERVIDOR_USUARIO:-kali}"
SERVIDOR_IP="${SERVIDOR_IP:-192.168.1.50}"

# Llave SSH con la que la computadora de desarrollo entra al servidor
LLAVE_SERVIDOR="${LLAVE_SERVIDOR:-$HOME/.ssh/logue_servidor}"

# Repositorio en GitHub (se clona por SSH usando la deploy key)
REPO_GITHUB="${REPO_GITHUB:-git@github-logue:ManigoldoR15/logue-backend.git}"
RAMA="${RAMA:-main}"

# Rutas en el servidor
RUTA_REPO="${RUTA_REPO:-$HOME/logue-backend}"   # código clonado de GitHub
RUTA_APP="${RUTA_APP:-$HOME/logue-app}"         # jar que está corriendo
RUTA_BACKUPS="${RUTA_BACKUPS:-$HOME/logue-backups}"
BACKUPS_A_GUARDAR="${BACKUPS_A_GUARDAR:-7}"

PUERTO_APP=8080
SERVICIO=logue-backend
